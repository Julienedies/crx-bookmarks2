{
  "manifest_version": 3,

  "name": "bookmarks2",
  "description": "A chrome extension for managing bookmarks.",
  "version": "0.1.53",
  "options_page": "dist/app.html",

  "permissions": [
    "chrome://favicon/",
    "favicon",
    "tabs",
    "activeTab",
    "contextMenus",
    "downloads",
    "storage",
    "bookmarks"
  ],
  
  "host_permissions": [
    "chrome://favicon/",
    "<all_urls>",
    "http://*/*",
    "https://*/*",
    "file:///*/*"
  ],
  
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  
  "icons": {
    "16": "assets/img/bookmarks3.png",
    "48": "assets/img/bookmarks3.png",
    "128": "assets/img/bookmarks3.png"
  },
  
  "action": {
    "default_icon": "assets/img/bookmarks3.png",
    "default_popup": "dist/popup.html",
    "default_title": "书签管理器"
  },

   "web_accessible_resources": [
    {
      "resources": ["favicon.png"],
      "matches": ["chrome://favicon/*"]
    }
  ]
}